# Caddy terminates TLS and forwards to the SPA's nginx, which in turn proxies
# /api and /oauth2 to the api-gateway.
#
# HTTPS is not optional here: the ElevenLabs voice agent calls
# navigator.mediaDevices.getUserMedia, which browsers only expose in a secure
# context. Over plain http:// on an EC2 IP the talk button reports that it
# cannot use the microphone.
#
# SITE_ADDRESS comes from .env (a bare hostname, no scheme). Caddy obtains and
# renews a Let's Encrypt certificate for it over HTTP-01, so port 80 must stay
# open to the internet even though all real traffic is on 443.

{$SITE_ADDRESS} {
	encode gzip

	reverse_proxy frontend:80 {
		# Client IP for the services' rate limiters. nginx appends to this and
		# the services walk it right-to-left, skipping the pinned 172.28.0.0/16
		# hops to find the real caller.
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}