# Copy to .env NEXT TO docker-compose.prod.yml on the EC2 host, fill it in,
# then: chmod 600 .env
#
# Every value marked REQUIRED is enforced at boot — the services' ProdSafetyGuard
# refuses to start on a dev default rather than run insecurely.

# ---------- where the app lives ----------
# Bare hostname, no scheme. With no domain yet, use your Elastic IP with dots
# replaced by dashes + .sslip.io — that resolves to your IP and Let's Encrypt
# will issue a real certificate for it.
SITE_ADDRESS=13-53-1-2.sslip.io
# The same host WITH the scheme. Used for CORS on the gateway and auth-service;
# both reject a value containing "localhost".
SITE_URL=https://13-53-1-2.sslip.io

# ---------- images ----------
# <account-id>.dkr.ecr.<region>.amazonaws.com
ECR_REGISTRY=123456789012.dkr.ecr.ap-south-1.amazonaws.com
IMAGE_TAG=latest

# ---------- RDS ----------
DB_HOST=autoops-db.abcdefghijkl.ap-south-1.rds.amazonaws.com
DB_USER=autoops
# REQUIRED. Must NOT be the literal "autoops" — that is the dev default and
# every service refuses to boot with it.
DB_PASSWORD=

# ---------- auth-service ----------
# REQUIRED. Password for secrets/jwt-keystore.p12 (created in the deploy steps).
JWT_KEYSTORE_PASSWORD=
# REQUIRED. Must NOT be "gateway-secret". openssl rand -hex 32
GATEWAY_CLIENT_SECRET=

# ---------- SendGrid (REQUIRED — auth-service will not start without it) ----------
# Key needs only the Mail Send permission.
SENDGRID_API_KEY=
# Must be a verified sender in SendGrid (Single Sender Verification is enough —
# you do not need to own a domain).
SENDGRID_FROM_EMAIL=no-reply@yourdomain.com
# Optional dynamic template ({{otp}}, {{ttlMinutes}}). Leave the sentinel to
# send plain-text emails instead.
SENDGRID_OTP_TEMPLATE_ID=REPLACE_ME

# ---------- internal service-to-service secrets ----------
# REQUIRED, every one. openssl rand -hex 32 for each — DIFFERENT values.
# These are not interchangeable: each is the only thing standing between the
# open network and a service's /internal API, and reusing one value means a
# single leak opens all of them.
#
# job-service runs arbitrary commands by design; this token is the only thing
# standing in front of it.
JOB_INTERNAL_TOKEN=
SUBSCRIPTION_INTERNAL_TOKEN=
# Guards core-service's own /internal/**, which workflow-service and
# agent-service call back into to record runs, approvals and audit events.
CORE_INTERNAL_TOKEN=
# Guards workflow-service's /internal/**. A dev default here lets anyone who
# can reach the service rewrite a tenant's workflow definitions, and the edit
# is indistinguishable from a legitimate one once saved.
WORKFLOW_INTERNAL_TOKEN=
# Guards agent-service's /internal/**. The agent loop spends the tenant's model
# budget and calls tools that touch their infrastructure.
AGENT_INTERNAL_TOKEN=
# Guards plugin-service's /internal/events, where core-service posts run
# lifecycle events. A dev default lets anyone send notifications as any tenant.
PLUGIN_INTERNAL_TOKEN=

# ---------- encryption keys ----------
# AES-GCM key encrypting stored cloud credentials (AWS keys, kubeconfigs,
# service-account JSON) at rest. SET IT ONCE. Changing it later makes every
# already-saved integration permanently undecryptable.
CLOUD_CRED_KEY=
# AES-GCM key encrypting notification-channel credentials (webhook URLs, API
# tokens, SMTP passwords). Separate from CLOUD_CRED_KEY on purpose — one leaked
# key must not open both vaults. Same warning: SET IT ONCE, changing it strands
# every stored channel credential.
PLUGIN_CRED_KEY=

# ---------- ElevenLabs voice agent (optional) ----------
# Without both, the service reports itself disabled and the landing page simply
# omits the talk button. Nothing else breaks.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
VOICE_AGENT_NAME=Aegis-01