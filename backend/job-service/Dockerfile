# Multi-stage: build with Maven, run on a slim JRE as a non-root user.
# The runtime image carries the step toolchain: bash (scripts), python3 +
# pip with requests & boto3 preinstalled (pyscript steps), an ssh client
# (ssh steps), curl (handy in commands).
# Build base pinned by digest too (tag kept for readability) — reproducible jar.
FROM maven:3.9-eclipse-temurin-21@sha256:2b4496088e7b80ae10a8c9f74e574ea21380325a006ec684532ad6bad5bc7273 AS build
WORKDIR /build
COPY pom.xml .
RUN mvn -q dependency:go-offline
COPY src ./src
RUN mvn -q package -DskipTests

# Base pinned by digest (bit-for-bit reproducible); the tag stays for readability
# but the digest is what Docker resolves. Alpine 3.23 also keeps the pinned apk
# versions below resolvable. To update: re-pull the tag and swap in the new digest.
FROM eclipse-temurin:21-jre-alpine-3.23@sha256:3f08b13888f595cc49edabea7250ba69499ba25602b267da591720769400e08c
# opentofu is the Terraform-compatible CLI shipped by Alpine (terraform's
# BUSL license keeps it out of the repos) — symlinked so both names work.
# All apk packages pinned to their Alpine 3.23 repo versions for reproducibility;
# bump a -rN suffix if Alpine rebuilds a package (old builds drop out of the
# mirror). openssh-client-default is the concrete 3.23 package that ships
# /usr/bin/ssh (the old "openssh-client" name no longer exists on 3.23).
RUN apk add --no-cache \
        bash=5.3.3-r1 \
        python3=3.12.13-r0 \
        py3-pip=25.1.1-r1 \
        openssh-client-default=10.2_p1-r0 \
        curl=8.20.0-r0 \
        opentofu=1.10.6-r8 \
        kubectl=1.34.2-r6 \
        su-exec=0.3-r0 \
    && ln -sf /usr/bin/tofu /usr/local/bin/terraform \
    && addgroup -S autoops && adduser -S autoops -G autoops \
    && rm -f /var/log/apk.log   # apk logs wall-clock timestamps → breaks reproducibility
# The step-user pool. Steps are tenant-authored code: with one shared uid, a
# step can read a concurrent step's decrypted kubeconfig or service-account key
# (same-owner files, /proc/<pid>/environ). Each step leases one of these users
# for its lifetime, so the kernel — not a file mode — keeps tenants apart.
# These users own nothing, have no home and no shell. Keep the count in step
# with autoops.jobs.sandbox.user-count.
RUN addgroup -S -g 900 autoops-steps \
    && for i in $(seq 1 8); do \
         adduser -S -D -H -G autoops-steps -s /sbin/nologin -u $((900 + i)) "autoops-step$i"; \
       done \
    # /etc/shadow's third field is the account's "last changed" day — i.e. the
    # BUILD DATE, so the same source produced a different image tomorrow. Pin
    # it to the fixed date the rest of the build uses (2025-01-01 is day 20089,
    # 1735689600 / 86400). Applies to every account, including autoops above.
    && sed -i -E 's/^([^:]+:[^:]*:)[0-9]+:/\120089:/' /etc/shadow
# Pyscript libraries (requests, boto3), hash-locked for reproducible, tamper-proof
# builds. requirements.txt is generated by pip-compile --generate-hashes from
# requirements.in; --require-hashes verifies every artifact's SHA256 before install.
# --no-compile + compileall with unchecked-hash produces hash-based .pyc files
# (no embedded mtimes), so the layer is byte-for-byte reproducible.
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --break-system-packages --require-hashes --no-compile \
        -r /tmp/requirements.txt \
    && python3 -m compileall -q -f --invalidation-mode unchecked-hash \
        /usr/lib/python3.12/site-packages \
    && rm /tmp/requirements.txt
# PID 1 stays root ONLY so it can drop privileges per step: the JVM never
# executes tenant code itself — every step is exec'd through su-exec as an
# autoops-stepN user. If that pool is ever unavailable, StepSandbox REFUSES to
# run steps rather than fall back to uid 0. /app is root-owned and no step user
# can write to it. (Set autoops.jobs.sandbox.enabled=false only on a dev box.)
WORKDIR /app
COPY --from=build /build/target/job-service-*.jar app.jar
ENV JAVA_OPTS="-XX:MaxRAMPercentage=75"
EXPOSE 8084
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
