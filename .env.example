



# Copy to .env (same folder as docker-compose.yml). NEVER commit .env.
# docker compose reads it automatically.

# --- SendGrid (real OTP + invite emails) ---
# API key with Mail Send permission:
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxx
# Must be a VERIFIED sender (Single Sender or authenticated domain) in SendGrid:
SENDGRID_FROM_EMAIL=no-reply@yourdomain.com
# Optional: a SendGrid dynamic template for the OTP email ({{otp}}, {{ttlMinutes}}).
# Leave unset to send plain-text emails (works with just key + sender).
# SENDGRID_OTP_TEMPLATE_ID=d-xxxxxxxxxxxxxxxx

# --- Social login (Google / Microsoft) ---
# Google Cloud Console -> Credentials -> OAuth client (Web application);
# authorized redirect URI: http://localhost:8080/api/auth/sso/google/callback
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...
# Azure portal -> Entra ID -> App registrations (multitenant + personal);
# redirect URI (Web): http://localhost:8080/api/auth/sso/microsoft/callback
# MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
# MS_CLIENT_SECRET=...

# --- ElevenLabs (Aegis-01, the landing-page voice agent) ---
# Without both of these the voice-agent reports itself disabled and the landing
# page omits the "Tap to speak with Aegis-01" button — nothing else breaks.
# The key never leaves the server: the browser only receives a 15-minute signed
# WebSocket URL, so treat this like any other production secret.
# ElevenLabs -> Developers -> API Keys (needs Agents/Conversational AI access):
# ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxx
# ElevenLabs -> Agents -> your agent -> the agent_… id:
# ELEVENLABS_AGENT_ID=agent_xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: the name shown on the button (defaults to Aegis-01).
# VOICE_AGENT_NAME=Aegis-01

# --- Payment stub (testing the PAST_DUE/retry path) ---
# PAYMENT_STUB_FAILS=true

# --- Internal secrets (compose falls back to well-known dev values) ---
# Shared secret core-service presents to job-service on /internal/**.
# job-service runs arbitrary commands BY DESIGN, so this token is the only
# thing standing in front of it — set a strong random value anywhere that is
# not a laptop. Must be identical for core-service and job-service.
#   openssl rand -hex 32
# JOB_INTERNAL_TOKEN=change-me
# Same idea for core-service -> subscription-service /internal/** calls.
# SUBSCRIPTION_INTERNAL_TOKEN=change-me
# The three services split apart at the workflow/agent boundary talk to each
# other over /internal/** too. Each token guards the endpoints of the service
# it is named after, and every caller of that service must present the same
# value:
#   CORE_INTERNAL_TOKEN     - workflow-service + agent-service -> core-service
#                             (projects, jobs, run stats, approval rules, audit)
#   WORKFLOW_INTERNAL_TOKEN - core-service + agent-service -> workflow-service
#                             (definitions, counts, SCM import writes)
#   AGENT_INTERNAL_TOKEN    - workflow-service -> agent-service (agent count)
#   PLUGIN_INTERNAL_TOKEN   - core-service -> plugin-service (lifecycle events)
#   AGENT_RUNTIME_INTERNAL_TOKEN
#                           - agent-service -> agent-runtime (the reasoning).
#                             This one carries the tenant's DECRYPTED model key
#                             on every call, so treat it like JOB_INTERNAL_TOKEN
#                             rather than like the read-only ones above.
# CORE_INTERNAL_TOKEN=change-me
# WORKFLOW_INTERNAL_TOKEN=change-me
# AGENT_INTERNAL_TOKEN=change-me
# PLUGIN_INTERNAL_TOKEN=change-me
# AGENT_RUNTIME_INTERNAL_TOKEN=change-me
# AES-GCM key that encrypts stored cloud-integration credentials (AWS keys,
# kubeconfigs, service-account JSON) at rest in core-service. Changing it
# makes every already-stored credential undecryptable — set it once, before
# the first integration is saved, and keep it.
# CLOUD_CRED_KEY=change-me

# --- Agent runtime (the Python reasoning service) ---
# The kill switch. Leave unset (or "true") to run agents on the phased Python
# runtime. Set false to send every run back to agent-service's own Java chat
# adapters — the loop that shipped before agent-runtime existed. It is one
# variable and a restart, on purpose: it is meant to be usable at 3am by
# someone who does not want to reason about it first.
# AGENT_RUNTIME_ENABLED=false
# Ceiling on ONE model reply. The per-RUN budget is agent-service's step count,
# not this.
# AGENT_RUNTIME_MAX_TOKENS=4096

# --- Tracing (Langfuse; docker compose --profile tracing up -d) ---
# Off by default, and best-effort when on: agent-runtime logs a warning and
# runs untraced rather than failing a run because the tracer is unreachable.
# Bring the profile up, open http://localhost:3001, create a project, then
# paste its keys here and restart agent-runtime.
# LANGFUSE_ENABLED=true
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# These two have well-known dev defaults in compose and MUST be replaced
# anywhere that is not a laptop: NEXTAUTH_SECRET signs session cookies and SALT
# keys the API-key hashes, so a shared default means anyone who has read the
# compose file can mint a session.
#   openssl rand -hex 32
# LANGFUSE_NEXTAUTH_SECRET=change-me
# LANGFUSE_SALT=change-me
# LANGFUSE_DB_PASSWORD=change-me

# --- Notification channels (plugin-service) ---
# AES-GCM key encrypting every stored channel credential: Slack and Teams
# webhook URLs, GitHub tokens, Gmail/Outlook SMTP passwords.
#
# DELIBERATELY NOT the same value as CLOUD_CRED_KEY above. One key per vault,
# so compromising the cloud-credential key does not also open every tenant's
# chat and mailbox. Same warning applies: changing it makes already-stored
# channels undecryptable and every tenant has to re-enter their settings.
#   openssl rand -hex 32
# PLUGIN_CRED_KEY=change-me
#
# Origin used to build the "Open in AutoOps" link inside a notification.
# Defaults to http://localhost:5173, which is useless in a real deployment —
# every alert would link somewhere the recipient cannot reach.
# CONSOLE_BASE_URL=https://autoops.yourcompany.com
#
# Optional tuning (defaults shown). PLUGIN_NOTIFICATIONS_ENABLED=false is the
# kill switch: core-service stops emitting events entirely.
# PLUGIN_NOTIFICATIONS_ENABLED=true
# PLUGIN_STALLED_AFTER=2h        # a run open this long is reported STALLED
# PLUGIN_MISSED_AFTER=10m        # how far past due before a schedule is MISSED
# PLUGIN_DELIVERY_RETENTION=P30D # how long the delivery log is kept

# --- Dify (workflow design + execution) ---
# The workflow designer and the run engine both go through Dify. core-service
# holds these; the browser never sees the key. Without them the designer
# reports "Dify is not connected" instead of failing obscurely.
# DIFY_BASE_URL=https://dify.yourcompany.com
# DIFY_API_KEY=
# NOTE: DIFY_API_KEY is Dify's CONSOLE token (core-service calls /console/api/**
# with it), not an app "app-..." Service API key.
#
# RUNNING a workflow uses the other credential: Dify mints a Service API key
# PER PUBLISHED APP, and those are the "app-..." ones. List them here as
# slug=key pairs. The slug is yours to choose - it is what a catalog item
# stores, so the key itself never reaches a browser.
#
#   DIFY_WORKFLOW_KEYS=patch-tuesday=app-xxxx,user-offboarding=app-yyyy
#
# core-service also accepts one variable per workflow, for secret managers
# that inject individually - DIFY_WF_PATCH_TUESDAY=app-xxxx. Either way,
# restart core-service after changing a key; they are read once at startup.
# Publish the workflow in Dify FIRST: an unpublished app has no Service API.
# DIFY_WORKFLOW_KEYS=

# --- Public demo over ngrok (deploy-demo/) ---
# Only needed to put this laptop stack on a public URL for a client demo.
# See deploy-demo/README.md.
#
# COMPOSE_FILE is the load-bearing line. Compose reads it from .env before
# anything else, so EVERY `docker compose` command run from the repo root loads
# the demo overlay automatically - a bare `docker compose up -d`, Docker
# Desktop, IntelliJ's Compose integration, all of them.
#
# Without it, any Compose command that omitted the overlay silently recreated
# auth-service, api-gateway, core-service, plugin-service and the frontend with
# plain localhost settings. Nothing looked broken except that login started
# returning 403 "Invalid CORS request" on the public URL.
#
# To run localhost-only on purpose, pass -f explicitly (an explicit -f beats
# COMPOSE_FILE) - which is what deploy-demo\down.ps1 does.
# COMPOSE_FILE=docker-compose.yml;deploy-demo/docker-compose.demo.yml
# COMPOSE_PATH_SEPARATOR=;
#
# From dashboard.ngrok.com - Your Authtoken, and Domains (bare hostname).
# NGROK_AUTHTOKEN=
# NGROK_DOMAIN=your-name.ngrok-free.app
