# Normalize line endings in the repo; check out native on each platform.
* text=auto

# Files that must stay LF or they break inside Linux containers.
*.sh        text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
Caddyfile   text eol=lf
*.conf      text eol=lf

# Windows-only tooling stays CRLF.
*.ps1       text eol=crlf
*.psm1      text eol=crlf

# Binary assets.
*.png       binary
*.jpg       binary
*.ico       binary
*.woff2     binary
*.xlsx      binary
*.pdf       binary