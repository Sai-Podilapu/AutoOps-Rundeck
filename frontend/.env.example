# Base URL for the AutoOps backend API.
# Leave as /api in development so the Vite dev proxy forwards to the auth-service
# (http://localhost:8081) defined in vite.config.js.
# In production, set this to your backend origin + /api, e.g.
#   VITE_API_URL=https://api.autoops.com/api
VITE_API_URL=/api

# Optional: override the dev proxy target (defaults to http://localhost:8081).
# VITE_PROXY_TARGET=http://localhost:8081
